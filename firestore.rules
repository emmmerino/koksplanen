rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Byt ut adresserna mot era två Google-konton innan reglerna klistras in i Firebase.
    function familj() {
      return request.auth != null
        && request.auth.token.email_verified
        && request.auth.token.email in ['DIN@gmail.com', 'SAMBO@gmail.com'];
    }
    match /{document=**} {
      allow read, write: if familj();
    }
  }
}
